{
  "name": "aether-agent",
  "version": "0.2.0",
  "description": "Aether — Adaptive Cross-Market Intelligence Agent for Binance Agent OS (hackathon submission)",
  "main": "dist/cli.js",
  "bin": {
    "aether": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-build.cjs && tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "demo": "node dist/cli.js demo",
    "test": "jest --runInBand",
    "pretest": "npm run build",
    "test:watch": "jest --watch",
    "dashboard": "cd web && npm run dev",
    "backtest": "node dist/cli.js backtest",
    "test:e2e": "echo 'Placeholder for e2e tests' && exit 0",
    "verify": "npm run build && npm test -- --runInBand && cd web && npm run lint && npm run build && cd .. && npm run demo -- --allow-context-switch"
  },
  "license": "MIT",
  "dependencies": {
    "technicalindicators": "^3.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "engines": {
    "node": ">=22"
  }
}
